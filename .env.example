# --- Database (Neon PostgreSQL). Leave empty in local dev to use an on-disk PGlite database in .data/ ---
DATABASE_URL=

# --- Auth.js (single admin user) ---
AUTH_SECRET=                # openssl rand -base64 32
ADMIN_EMAIL=reemfathima66@gmail.com
ADMIN_PASSWORD_HASH=        # npm run admin:hash -- "your password"

# --- Media storage (Neon Object Storage; private bucket, the app serves files itself). Leave empty in local dev to write to public/uploads ---
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=assets

# --- Cloudflare Turnstile (contact form). Leave empty in local dev to skip the check ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
